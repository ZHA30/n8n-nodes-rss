{
	"compilerOptions": {
		"strict": true,
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "es2019",
		"lib": ["es2022"],
		"removeComments": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/",
		"rootDir": "."
	},
	"include": ["nodes/**/*.ts", "nodes/**/*.json"]
}
